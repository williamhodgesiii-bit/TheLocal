<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability; Xcode switches this to production when you archive for the App Store -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- links to www.theplatenextdoor.com open the app, and passkeys saved for the site work in it
	     (the site serves /.well-known/apple-app-site-association once APPLE_TEAM_ID is set in Vercel) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.theplatenextdoor.com</string>
		<string>webcredentials:www.theplatenextdoor.com</string>
	</array>
</dict>
</plist>

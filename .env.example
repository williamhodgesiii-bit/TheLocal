# All optional — the site works with zero config (reviews/photos/accounts are stored on-device in demo mode).

# Supabase: accounts, the database and photo uploads. Run supabase/schema.sql first (README → Accounts).
# The Vercel ↔ Supabase integration fills these in. Either key name works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # or NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=                       # server only, for "Delete my account" (or SUPABASE_SERVICE_ROLE_KEY)

# Sign-in extras (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=              # "Continue with Google" + one-tap
NEXT_PUBLIC_PASSKEYS=                      # "on" after enabling Authentication → Passkeys in Supabase
NEXT_PUBLIC_AUTH_CODE_LENGTH=              # default 6; match Supabase → Email OTP Length

# Google Analytics 4 measurement id (G-…). Skipped for visitors with Global Privacy Control.
NEXT_PUBLIC_GA_ID=

# Google Places (New): real storefront/food photos, Google rating & website on each spot. Server-only.
GOOGLE_PLACES_API_KEY=

# Canonical URL for SEO (sitemap, OG). Falls back to Vercel's URL.
NEXT_PUBLIC_SITE_URL=

# Optional custom basemap tiles (e.g. a licensed provider for commercial scale). Default: CARTO dark.
NEXT_PUBLIC_MAP_TILES=
NEXT_PUBLIC_MAP_STYLE=        # optional MapLibre style URL (default: OpenFreeMap positron, free, no key)

# Demo mode only: limit the /admin verification desk to these emails (comma-separated).
# With Supabase, staff are listed in the `admin_emails` table instead (see supabase/schema.sql).
NEXT_PUBLIC_ADMIN_EMAILS=

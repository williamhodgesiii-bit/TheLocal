# All optional — the site works with zero config (reviews/photos/accounts are stored on-device in demo mode).

# Supabase: real accounts, shared reviews and photo uploads. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Places (New): real storefront/food photos, Google rating & website on each spot. Server-only.
GOOGLE_PLACES_API_KEY=

# Canonical URL for SEO (sitemap, OG). Falls back to Vercel's URL.
NEXT_PUBLIC_SITE_URL=

# Optional custom basemap tiles (e.g. a licensed provider for commercial scale). Default: CARTO dark.
NEXT_PUBLIC_MAP_TILES=
NEXT_PUBLIC_MAP_LABEL_TILES=   # set to "none" to hide street labels

# Demo mode only: limit the /admin verification desk to these emails (comma-separated).
# With Supabase, staff are rows in the `admins` table instead (see supabase/schema.sql).
NEXT_PUBLIC_ADMIN_EMAILS=
